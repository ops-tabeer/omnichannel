# Dev environment template for dev-chat.orbitechsol.com
# Copy to .env.dev on the VPS, fill in the <REPLACE_*> values, then run
# the first-time setup commands in INFRA.md.
#
# DO NOT commit .env.dev (it is git-ignored).

# Generate fresh: openssl rand -hex 64
SECRET_KEY_BASE=<REPLACE_SECRET_KEY_BASE>

FRONTEND_URL=https://dev-chat.orbitechsol.com
RAILS_ENV=production
NODE_ENV=production
INSTALLATION_ENV=docker

# Database (own postgres container; host port 5434, internal 5432)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USERNAME=postgres
# Generate fresh: openssl rand -hex 16
POSTGRES_PASSWORD=<REPLACE_POSTGRES_PASSWORD>
POSTGRES_DATABASE=chatwoot_dev

# Redis (own redis container; host port 6380, internal 6379)
REDIS_URL=redis://redis:6379
# Generate fresh: openssl rand -hex 16
REDIS_PASSWORD=<REPLACE_REDIS_PASSWORD>

# SMTP — same provider as prod, distinct sender so support inboxes can tell dev mail apart
MAILER_SENDER_EMAIL=Tabeer Tours Dev <dev-support@tabeertours.com>
SMTP_DOMAIN=tabeertours.com
SMTP_ADDRESS=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=<REPLACE_SMTP_USERNAME>
SMTP_PASSWORD=<REPLACE_SMTP_APP_PASSWORD>
SMTP_AUTHENTICATION=login
SMTP_ENABLE_STARTTLS_AUTO=true

FORCE_SSL=true
ENABLE_ACCOUNT_SIGNUP=true
RAILS_MAX_THREADS=5
SIDEKIQ_CONCURRENCY=5
WEB_CONCURRENCY=1
ACTIVE_STORAGE_SERVICE=local

RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info
